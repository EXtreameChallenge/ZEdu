# ===== 应用配置 =====
APP_NAME=ZEdu Duo
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
# SQL 回显与热重载独立开关：DEV_RELOAD=true 时 uvicorn 只监视 backend/，
# 否则会连 data/ 下的 chroma 与 sqlite -wal 一起监视 → 每次业务写入自重启
DB_ECHO=false
DEV_RELOAD=false

# ===== 服务器配置 =====
HOST=0.0.0.0
PORT=8000
# CORS来源白名单（逗号分隔）。生产环境改为你的域名，如 https://zedu.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 数据库配置 =====
DATABASE_URL=sqlite+aiosqlite:///./data/zedu_duo.db

# ===== JWT认证配置 =====
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== AI模型配置（智谱GLM） =====
# 多个Key用逗号分隔，系统自动轮询
ZHIPU_API_KEYS=your-zhipu-api-key-1,your-zhipu-api-key-2
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ===== 降级模型配置（通义千问，可选） =====
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=qwen-turbo

# ===== 向量数据库配置 =====
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=embedding-3

# ===== 内容安全配置 =====
CONTENT_SAFETY_ENABLED=true
SENSITIVE_WORDS_FILE=./backend/content_safety/sensitive_words.txt

# ===== 限流配置 =====
RATE_LIMIT_PER_MINUTE=300

# ===== 合规配置 =====
MIN_AGE_REQUIRED=14
PRIVACY_POLICY_URL=/privacy-policy

# ===== 讯飞星火配置（可选，软件杯要求讯飞相关工具链） =====
XINGHUO_API_KEY=your-xinghuo-app-api-key
XINGHUO_BASE_URL=https://spark-api-open.xf-yun.com/v1
XINGHUO_MODEL=generalv3.5
